# Copy this file to .env and fill in the values.
#
# This file grows one line at a time, as each smoke test needs something. Do not add a variable
# before the test that uses it exists — with one exception: if a credential has already been
# provisioned, its name belongs here immediately. `.env` is gitignored, so a name that lives only
# there is one `git clean` from gone.

# The Graph — gateway query key.
# Free at https://thegraph.com/studio — sign in with any EVM wallet, no payment.
# 100,000 queries/month on the free tier.
GRAPH_API_KEY=

# Anthropic — Claude API key, for the agent (SM-06 onward).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ethereum mainnet RPC — for SM-04, the archive-RPC test.
# ⚠️ MUST BE ARCHIVE-CAPABLE. Subgraph heads routinely lag chain head by more than 128 blocks, and a
# non-archive node serves state only for roughly the last 128. SM-04 reads a value at block N from a
# subgraph and re-reads it at block N over this RPC; a pruned node cannot answer and the test is
# recorded as NOT_CHECKED instead (§5.14, R27).
ETHEREUM_RPC_URL=

# Hedera — x402 payment pair, for SM-05.
#
# ⚠️ TESTNET, not mainnet. R12 is taken; see tracking/DECISIONS.md. R12 requires that the facilitator
# URL, network string, USDC token id and accounts move together or not at all:
#
#   facilitator   https://api.testnet.blocky402.com   (feePayer 0.0.7162784)
#   network       hedera:testnet                      (the x402 network string)
#   USDC token    0.0.429274
#   accounts      the four below
#
# Both accounts need the testnet USDC token associated, plus faucet HBAR to pay for the association
# transaction itself. https://portal.hedera.com/faucet

# Seller — the treasury account that receives payment, the x402 `payTo`.
HEDERA_SELLER_ID=
HEDERA_SELLER_KEY=

# Buyer — the agent account that pays.
HEDERA_BUYER_ID=
HEDERA_BUYER_KEY=

# `testnet` or `mainnet` — the Hedera SDK's network name, which is not the same string as the x402
# network identifier above. Per R12 this never moves on its own.
HEDERA_NETWORK=testnet

# Circle — developer-controlled wallets, for SM-08.
#
# https://console.circle.com/wallets/dev/configurator — the API key and the entity secret are a pair,
# and sandbox keys are not interchangeable with production ones.
CIRCLE_API_KEY=

# A 32-byte hex value (64 hex characters), generated by `scripts/provision-circle.ts`.
#
# ⚠️ It must be registered with Circle before any wallet call will work: the console's Register form
# wants the secret encrypted with Circle's entity public key, which is the ciphertext that script
# prints. Registration is done by hand in the console, because that is what produces the recovery
# file.
#
# ⚠️ Losing this value means re-provisioning every wallet derived from it. It cannot be recovered
# from Circle and it cannot be rotated in place. Keep it here and keep the console's recovery file
# somewhere durable.
CIRCLE_ENTITY_SECRET=

# Hedera JSON-RPC relay — for SM-07, the ATS issue-and-transfer test.
#
# ATS tokens are plain ERC-20 on the Hedera EVM, driven with ethers rather than the Hedera SDK, so
# they need an EVM RPC endpoint rather than a consensus-node connection. Hashio is the public relay
# and needs no key. The same four Hedera accounts above are reused: the seller is deployer, admin
# and issuer, the buyer is the transfer recipient. Their EVM addresses are derived from the keys —
# no extra variables — and checked against Mirror Node before anything is signed.
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api

# Arc testnet — for SM-08, the Circle payable-call test.
#
#   chain     ARC-TESTNET, chainId 5042002
#   RPC       https://rpc.testnet.arc.network
#   explorer  https://testnet.arcscan.app
#   USDC      0x3600000000000000000000000000000000000000 — native, and the ERC-20 view reports 6dp
#
# ⚠️ A funded EOA that is NOT the Circle wallet. Circle's developer-controlled-wallets client cannot
# deploy contracts — `deployContract` is in the package typings but is not exposed on the client — so
# SM-08's receiver contract is deployed with ethers instead. This is a separate key on purpose: the
# alternative was funding a deployer out of the Circle wallet mid-script, which puts a transaction
# that can fail on its own between us and the measurement the test exists to make.
ARC_DEPLOYER_KEY=

# The Circle developer-controlled wallet SM-08 provisions on its first run, printed by that run.
#
# ⚠️ Set it and keep it. Re-running SM-08 without it creates a SECOND wallet, and `claimId` derives
# the author from `msg.sender` (§5.18) — a new wallet is a silently wrong author, not a duplicate.
# The wallet is accountType EOA, never SCA, because an EOA's Circle address is deterministic.
CIRCLE_WALLET_ID=
