# Copy this file to .env and fill in the values.
#
# This file grows one line at a time, as each smoke test needs something.
# Do not add a variable here before the test that uses it exists.

# The Graph — gateway query key.
# Free at https://thegraph.com/studio — sign in with any EVM wallet, no payment.
# 100,000 queries/month on the free tier.
GRAPH_API_KEY=

# Anthropic — Claude API key, for the agent (SM-06 onward).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
